{
  "$id": "https://github.com/African-River-Corridors/open-report-designer/blob/main/schema/ord-document.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open Report Designer document",
  "description": "A report document.",
  "type": "object",
  "properties": {
    "ord": {
      "description": "Format version: \"0.1\" or \"0.2\". Fields marked \"(0.2)\" need \"0.2\".",
      "type": "string"
    },
    "class": {
      "description": "A document class id from the register, such as \"report\".",
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": [
        "string",
        "null"
      ]
    },
    "organisation": {
      "description": "Shown on the cover and in the footer.",
      "type": [
        "string",
        "null"
      ]
    },
    "language": {
      "description": "BCP 47 language tag. Default \"en\".",
      "type": [
        "string",
        "null"
      ]
    },
    "control": {
      "$ref": "#/$defs/Control"
    },
    "summary": {
      "description": "A short summary on the cover page (Markdown).",
      "type": [
        "string",
        "null"
      ]
    },
    "notice": {
      "description": "A notice on the cover and in the footer, such as \"Screening tool. Not for construction.\"",
      "type": [
        "string",
        "null"
      ]
    },
    "contents": {
      "description": "Table of contents. Default from the document class.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "cover_image": {
      "description": "(0.2) A photograph across the head of the cover.",
      "anyOf": [
        {
          "$ref": "#/$defs/CoverImage"
        },
        {
          "type": "null"
        }
      ]
    },
    "cover_logos": {
      "description": "(0.2) A strip of logos on the cover, each with a name and a role, such as the parties to a report.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/CoverLogo"
      }
    },
    "cover_details": {
      "description": "(0.2) The rows of the cover's control block, in place of number, revision, date and status. An empty\nlist leaves the block out.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/DataItem"
      }
    },
    "footer": {
      "description": "(0.2) The text on the left of the running foot, in place of the organisation and the notice.",
      "type": [
        "string",
        "null"
      ]
    },
    "body": {
      "description": "The main matter.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Block"
      }
    },
    "appendices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Appendix"
      }
    },
    "assets": {
      "description": "Asset id to image.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/AssetSource"
      }
    },
    "template": {
      "anyOf": [
        {
          "$ref": "#/$defs/TemplateOverrides"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "ord",
    "class",
    "title",
    "control",
    "body"
  ],
  "$defs": {
    "Control": {
      "description": "Document control (spec 0001 §3.2).",
      "type": "object",
      "properties": {
        "number": {
          "description": "The document number. Starts with \"<prefix>-\" when the class has a number prefix.",
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "description": "The revision: a letter (A, B, ...) while working, a number (0, 1, ...) once issued.",
          "type": "string"
        },
        "date": {
          "description": "ISO 8601 date, YYYY-MM-DD.",
          "type": "string"
        },
        "status": {
          "description": "A status of the class's lifecycle.",
          "type": "string"
        },
        "sensitivity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sensitivity"
            },
            {
              "type": "null"
            }
          ]
        },
        "prepared": {
          "type": [
            "string",
            "null"
          ]
        },
        "checked": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved": {
          "type": [
            "string",
            "null"
          ]
        },
        "history": {
          "description": "Earlier and current revisions, oldest first.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/HistoryEntry"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "revision",
        "date",
        "status"
      ]
    },
    "Sensitivity": {
      "description": "Who may see the document.",
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "HistoryEntry": {
      "description": "One row of the revision history.",
      "type": "object",
      "properties": {
        "revision": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "revision",
        "date",
        "status",
        "description"
      ]
    },
    "CoverImage": {
      "description": "A photograph across the head of the cover (0.2).",
      "type": "object",
      "properties": {
        "asset": {
          "description": "An asset id.",
          "type": "string"
        },
        "alt": {
          "description": "Alt text. Required and not empty.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "asset",
        "alt"
      ]
    },
    "CoverLogo": {
      "description": "One logo of the cover's logo strip (0.2).",
      "type": "object",
      "properties": {
        "asset": {
          "description": "An asset id.",
          "type": "string"
        },
        "name": {
          "description": "The name printed under the logo. Also its alt text.",
          "type": "string"
        },
        "role": {
          "description": "A role printed under the name, such as \"Client\".",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "asset",
        "name"
      ]
    },
    "DataItem": {
      "description": "One line of a data box.",
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "label",
        "value"
      ]
    },
    "Block": {
      "description": "A block of the document (spec 0001 §3.3).\n\nRead by hand (`impl Deserialize` below) rather than by serde's internally tagged enum, which buffers the\nblock and so loses the path to an error inside it.",
      "oneOf": [
        {
          "description": "A section. Nesting sets the heading level (at most four).",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "section"
            },
            "id": {
              "type": [
                "string",
                "null"
              ]
            },
            "title": {
              "type": "string"
            },
            "numbered": {
              "description": "Default true. An unnumbered section takes no number, nor do its children.",
              "type": "boolean"
            },
            "body": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Block"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "title",
            "body"
          ]
        },
        {
          "description": "Markdown prose (spec 0001 §6).",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "prose"
            },
            "markdown": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "markdown"
          ]
        },
        {
          "description": "A table, numbered \"Table n\" when it has a caption.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "table"
            },
            "id": {
              "type": [
                "string",
                "null"
              ]
            },
            "caption": {
              "description": "The caption. Required in 0.1. (0.2) Optional: a table with no caption is not numbered.",
              "type": [
                "string",
                "null"
              ]
            },
            "header": {
              "description": "(0.2) Default true. False prints no header row: a table of labels and values.",
              "type": [
                "boolean",
                "null"
              ]
            },
            "column_groups": {
              "description": "(0.2) A row of group titles above the column titles. Each group spans one or more columns, in order;\nthe spans add up to the number of columns. A group with an empty title leaves its columns' titles\nspanning both header rows.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/ColumnGroup"
              }
            },
            "columns": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Column"
              }
            },
            "rows": {
              "description": "One cell per column in every row. A cell is plain text, or (0.2) `{ \"markdown\": \"...\" }`.",
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Cell"
                }
              }
            },
            "notes": {
              "description": "Notes under the table (Markdown).",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "columns",
            "rows"
          ]
        },
        {
          "description": "A figure, numbered \"Figure n\".",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "figure"
            },
            "id": {
              "type": [
                "string",
                "null"
              ]
            },
            "caption": {
              "type": "string"
            },
            "asset": {
              "description": "An asset id.",
              "type": "string"
            },
            "alt": {
              "description": "Alt text. Required and not empty.",
              "type": "string"
            },
            "width": {
              "description": "A fraction of the text width, 0 < width <= 1. Default 1.",
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "caption",
            "asset",
            "alt"
          ]
        },
        {
          "description": "A map: a figure with a key line (coordinate system, scale, source). Numbered with the figures.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "map"
            },
            "id": {
              "type": [
                "string",
                "null"
              ]
            },
            "caption": {
              "type": "string"
            },
            "asset": {
              "type": "string"
            },
            "alt": {
              "type": "string"
            },
            "width": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "crs": {
              "description": "The coordinate reference system, such as \"EPSG:32630\".",
              "type": [
                "string",
                "null"
              ]
            },
            "scale": {
              "description": "The scale, such as \"1:25 000\".",
              "type": [
                "string",
                "null"
              ]
            },
            "attribution": {
              "description": "The source of the map data.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "caption",
            "asset",
            "alt",
            "attribution"
          ]
        },
        {
          "description": "A boxed panel that states the data a result rests on and the limits of the result.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "data_box"
            },
            "id": {
              "type": [
                "string",
                "null"
              ]
            },
            "title": {
              "description": "Default \"Data and limits\".",
              "type": [
                "string",
                "null"
              ]
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/DataItem"
              }
            },
            "notes": {
              "description": "Notes under the items (Markdown).",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "items"
          ]
        }
      ]
    },
    "ColumnGroup": {
      "description": "A group of columns under one title (0.2).",
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "span": {
          "description": "The number of columns, at least 1.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "title",
        "span"
      ]
    },
    "Column": {
      "description": "A table column.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "align": {
          "anyOf": [
            {
              "$ref": "#/$defs/Align"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "description": "The unit, shown under the column title.",
          "type": [
            "string",
            "null"
          ]
        },
        "width": {
          "description": "(0.2) The column's share of the table width, 0 < w <= 1. Columns without one share the rest.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "title"
      ]
    },
    "Align": {
      "description": "Horizontal alignment of a table column.",
      "type": "string",
      "enum": [
        "left",
        "centre",
        "right"
      ]
    },
    "Cell": {
      "description": "A table cell: plain text, or (0.2) one paragraph of inline Markdown (emphasis, strong, code, links, hard\nline breaks and cross-references).",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/MarkdownCell"
        }
      ]
    },
    "MarkdownCell": {
      "description": "A table cell of inline Markdown (0.2).",
      "type": "object",
      "properties": {
        "markdown": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "markdown"
      ]
    },
    "Appendix": {
      "description": "An appendix: lettered A, B, ... (spec 0001 §5).",
      "type": "object",
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "body": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Block"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "title",
        "body"
      ]
    },
    "AssetSource": {
      "description": "An image the document uses: inline as base64, or a path that the caller reads (spec 0001 §3.4).",
      "type": "object",
      "properties": {
        "media_type": {
          "$ref": "#/$defs/MediaType"
        },
        "base64": {
          "description": "The image bytes, base64 (standard alphabet, padded).",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "A path relative to the document file. The core never reads it; the caller supplies the bytes.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "media_type"
      ]
    },
    "MediaType": {
      "description": "The asset types the engine reads: images, and (0.2) fonts for the template.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "image/svg+xml",
            "image/png"
          ]
        },
        {
          "description": "(0.2)",
          "type": "string",
          "const": "image/jpeg"
        },
        {
          "description": "(0.2) A TrueType or OpenType font file, or a font collection.",
          "type": "string",
          "const": "font/ttf"
        }
      ]
    },
    "TemplateOverrides": {
      "description": "Changes to the default template (spec 0001 §7).",
      "type": "object",
      "properties": {
        "organisation_logo": {
          "description": "An asset id for a logo on the cover.",
          "type": [
            "string",
            "null"
          ]
        },
        "paper": {
          "description": "Colours as \"#rrggbb\".",
          "type": [
            "string",
            "null"
          ]
        },
        "ink": {
          "type": [
            "string",
            "null"
          ]
        },
        "ink_2": {
          "type": [
            "string",
            "null"
          ]
        },
        "rule": {
          "type": [
            "string",
            "null"
          ]
        },
        "accent_ground": {
          "type": [
            "string",
            "null"
          ]
        },
        "cover": {
          "description": "Default true.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "cover_layout": {
          "description": "\"classic\" (the default) or \"photo\": a photograph band, the summary and the logo strip on cards, and\na control block.",
          "anyOf": [
            {
              "$ref": "#/$defs/CoverLayout"
            },
            {
              "type": "null"
            }
          ]
        },
        "cover_image_height_mm": {
          "description": "The height of the cover photograph, millimetres.",
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        },
        "cover_ink": {
          "description": "Colours as \"#rrggbb\": the cover's text, its accent (rules, the line under the title, labels), and the\nground of a cover card.",
          "type": [
            "string",
            "null"
          ]
        },
        "cover_accent": {
          "type": [
            "string",
            "null"
          ]
        },
        "card_ground": {
          "type": [
            "string",
            "null"
          ]
        },
        "heading_ink": {
          "description": "The colour of headings, and of the rule under a level-1 heading (none when unset).",
          "type": [
            "string",
            "null"
          ]
        },
        "heading_rule": {
          "type": [
            "string",
            "null"
          ]
        },
        "table_header_ink": {
          "description": "The text of a table's header row; its ground is `accent_ground`.",
          "type": [
            "string",
            "null"
          ]
        },
        "heading_sizes_pt": {
          "description": "Heading sizes for levels 1 to 4, points.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "format": "float"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "heading_bold": {
          "description": "Bold headings. Default false.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "heading_numbers": {
          "description": "\"spaced\" (\"2.1  Scope\", the default) or \"dotted\" (\"2. Scope\" at level 1, \"2.1 Scope\" below).",
          "anyOf": [
            {
              "$ref": "#/$defs/HeadingNumbers"
            },
            {
              "type": "null"
            }
          ]
        },
        "section_page_break": {
          "description": "A new page before each top-level section. Default true.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "heading_font": {
          "description": "Font family names. A family that is not bundled must be given by a `font/ttf` asset in `fonts`.",
          "type": [
            "string",
            "null"
          ]
        },
        "body_font": {
          "type": [
            "string",
            "null"
          ]
        },
        "fonts": {
          "description": "Asset ids of font files, used by the PDF and HTML writers. Word uses the family names and does not\nembed these files.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "body_size_pt": {
          "description": "Body text size, points.",
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        },
        "margins_mm": {
          "description": "Page margins, millimetres.",
          "anyOf": [
            {
              "$ref": "#/$defs/Margins"
            },
            {
              "type": "null"
            }
          ]
        },
        "control_page": {
          "description": "A document-control page after the cover. Default true.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "running_head": {
          "description": "The running head (number, revision, furniture). Default true.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "foot_sensitivity": {
          "description": "The sensitivity label in the middle of the running foot. Default false.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "table_widths": {
          "description": "\"content\": every writer sizes table columns by the same rule, from their text. Unset, each writer\nkeeps its 0.1 widths.",
          "anyOf": [
            {
              "$ref": "#/$defs/TableWidths"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision_prefix": {
          "description": "The word before the revision in the running head and on the cover foot. Default \"Rev \".",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "CoverLayout": {
      "description": "The cover's layout (0.2).",
      "type": "string",
      "enum": [
        "classic",
        "photo"
      ]
    },
    "HeadingNumbers": {
      "description": "How a heading's number is printed (0.2).",
      "type": "string",
      "enum": [
        "spaced",
        "dotted"
      ]
    },
    "Margins": {
      "description": "Page margins, millimetres (0.2).",
      "type": "object",
      "properties": {
        "top": {
          "type": "number",
          "format": "float"
        },
        "bottom": {
          "type": "number",
          "format": "float"
        },
        "left": {
          "type": "number",
          "format": "float"
        },
        "right": {
          "type": "number",
          "format": "float"
        }
      },
      "additionalProperties": false,
      "required": [
        "top",
        "bottom",
        "left",
        "right"
      ]
    },
    "TableWidths": {
      "description": "How table columns are sized (0.2).",
      "type": "string",
      "enum": [
        "content"
      ]
    }
  }
}
